<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    This repo has no dependency on any private/corporate feed — every
    package here (WPF, IconPacks, VSSDK analyzers, ...) is public. Without
    this file, restore inherits whatever feeds are registered machine-wide
    (dotnet nuget list source), which on a work laptop includes an internal
    company feed; when that host is unreachable (VPN down, off the office
    network), restore fails outright instead of just skipping a feed this
    project never needed. <clear/> + nuget.org pins this repo to the one
    public source regardless of what else is registered globally.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
