<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Brobot.Connection\Brobot.Connection.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- MiMo wordmark, used as the header graphic in MainWindow. mimo-trimmed.png is
         mimo.png with its huge transparent margin (the source is a 1254x1254 square
         for what's actually a wide, short wordmark) cropped down to the glyphs'
         real bounding box, so it renders at a legible size instead of a tiny sliver. -->
    <Resource Include="src\mimo.png" />
    <Resource Include="src\mimo-trimmed.png" />
    <!-- Tray icon source (see MainWindow.CreateTrayIcon) — a square "MiMo"
         wordmark on black, unlike mimo.png/mimo-trimmed.png above. -->
    <Resource Include="src\mimo-b.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copied (not embedded as a Resource) so ClaudeCodeHookInstaller can point
         a Claude Code hook command at a real file path next to the running exe,
         rather than a source-repo path that only exists on the dev machine. -->
    <None Include="..\..\hooks\mimo-claude-hook.ps1">
      <Link>mimo-claude-hook.ps1</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\hooks\mimo-claude-statusline.ps1">
      <Link>mimo-claude-statusline.ps1</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MahApps.Metro.IconPacks.Material" Version="6.2.1" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The 10.0.19041.0-suffixed TFM (not plain net8.0-windows) is what unlocks the
         Windows.Media.Control WinRT projection (GlobalSystemMediaTransportControlsSessionManager)
         used for the "now playing" feature, with no extra NuGet package needed. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- For the tray icon (System.Windows.Forms.NotifyIcon) — WPF has no tray-icon control of its own. -->
    <UseWindowsForms>true</UseWindowsForms>

    <!-- Bakes the icon into the .exe itself (Explorer, taskbar, Alt+Tab, shortcuts) —
         separate from MainWindow.xaml's own Window.Icon, which only affects the
         title bar and only once WPF has started up. mimo.ico is generated from
         src/mimo-b.png (same source as the runtime tray icon) so all three stay
         visually consistent. -->
    <ApplicationIcon>src\mimo.ico</ApplicationIcon>
    <Product>MiMo Sender</Product>
    <AssemblyTitle>MiMo Sender</AssemblyTitle>
    <Description>Envia hora, clima, mídia e atividade de IA para o seu Brobot</Description>
    <Version>1.0.1</Version>
    <NeutralLanguage>pt-BR</NeutralLanguage>

    <!-- The app's own UI has no other language, but WPF/WinForms still ship a
         localized satellite resource DLL per framework language by default
         (ru, tr, zh-Hans, ...) — dead weight for every user, and it visibly
         bloats the self-contained installer build. -->
    <SatelliteResourceLanguages>pt-BR</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
