<Window x:Class="Brobot.Display.Simulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Brobot.Display.Simulator"
        mc:Ignorable="d"
        Title="MiMo Virtual Display" Height="716" Width="540"
        ResizeMode="CanMinimize"
        Background="#FF1E1E1E">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Display controls -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Escala:" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="ScaleComboBox" Width="70" SelectionChanged="ScaleComboBox_SelectionChanged"/>
            <Button x:Name="ClearButton" Content="Limpar" Margin="16,0,0,0" Padding="10,3" Click="ClearButton_Click"/>
            <CheckBox x:Name="DemoCheckBox" Content="Demonstração interna" Foreground="White"
                      VerticalAlignment="Center" Margin="16,0,0,0" IsChecked="True"
                      Checked="DemoCheckBox_CheckedChanged" Unchecked="DemoCheckBox_CheckedChanged"/>
        </StackPanel>

        <!-- Serial (Arduino) source -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Porta:" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="PortComboBox" Width="110"/>
            <Button x:Name="RefreshPortsButton" Content="Atualizar" Margin="8,0,0,0" Padding="8,3" Click="RefreshPortsButton_Click"/>
            <Button x:Name="ConnectButton" Content="Conectar" Margin="8,0,0,0" Padding="8,3" Click="ConnectButton_Click"/>
            <TextBlock x:Name="SerialStatusText" Foreground="#FFAAAAAA" VerticalAlignment="Center" Margin="12,0,0,0" Text="Desconectado"/>
        </StackPanel>

        <!-- TCP (dev, no Arduino) source: connects to a native BrobotCore build, which listens the same way a real device's COM port would -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Host:Porta TCP:" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="TcpHostTextBox" Width="90" Text="127.0.0.1"/>
            <TextBox x:Name="TcpPortTextBox" Width="50" Margin="4,0,0,0" Text="5555"/>
            <Button x:Name="TcpConnectButton" Content="Conectar (dev, sem Arduino)" Margin="8,0,0,0" Padding="8,3" Click="TcpConnectButton_Click"/>
            <TextBlock x:Name="TcpStatusText" Foreground="#FFAAAAAA" VerticalAlignment="Center" Margin="12,0,0,0" Text="Desconectado"/>
        </StackPanel>

        <!-- Command sender (FACE / MSG) -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Comando:" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="CommandTextBox" Width="220" IsEnabled="False"
                     KeyDown="CommandTextBox_KeyDown"
                     ToolTip="Ex: FACE HAPPY  ou  MSG Ola mundo"/>
            <Button x:Name="SendCommandButton" Content="Enviar" Margin="8,0,0,0" Padding="8,3"
                    IsEnabled="False" Click="SendCommandButton_Click"/>
        </StackPanel>

        <!-- Display area -->
        <Border Grid.Row="4" BorderBrush="#FF444444" BorderThickness="1" Background="Black"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image x:Name="DisplayImage"
                   Stretch="Fill"
                   SnapsToDevicePixels="True"
                   UseLayoutRounding="True"
                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                   RenderOptions.EdgeMode="Aliased"/>
        </Border>

        <!-- Debug panel -->
        <Border Grid.Row="5" Background="#FF2A2A2A" BorderBrush="#FF444444" BorderThickness="1"
                Margin="0,12,0,0" Padding="10">
            <StackPanel>
                <TextBlock Foreground="#FFAAAAAA" FontWeight="Bold" Text="Debug" Margin="0,0,0,4"/>
                <TextBlock x:Name="ResolutionText" Foreground="#FFCCCCCC" FontFamily="Consolas"/>
                <TextBlock x:Name="ScaleText" Foreground="#FFCCCCCC" FontFamily="Consolas"/>
                <TextBlock x:Name="FpsText" Foreground="#FFCCCCCC" FontFamily="Consolas"/>
                <TextBlock x:Name="DrawOpsText" Foreground="#FFCCCCCC" FontFamily="Consolas"/>
                <TextBlock x:Name="SourceText" Foreground="#FFCCCCCC" FontFamily="Consolas"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
